<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="worldguesser.HighscoreController"
            prefWidth="500.0"
            prefHeight="750.0"
            style="-fx-background-color: #efcf93;"
            stylesheets="@style.css">

    <children>
        <VBox spacing="25.0"
              AnchorPane.topAnchor="20.0"
              AnchorPane.leftAnchor="22.0"
              AnchorPane.rightAnchor="22.0"
              AnchorPane.bottomAnchor="20.0">

            <HBox alignment="CENTER_LEFT">
                <Label text="Best times:"
                       style="-fx-font-size: 24px; -fx-text-fill: black;" />

                <Region HBox.hgrow="ALWAYS" />

                <Button fx:id="homeButton"
                        styleClass="customButton"
                        text="Home"
                        mnemonicParsing="false"
                        focusTraversable="false"
                        prefWidth="85.0"
                        prefHeight="38.0"
                        onAction="#goBack" />
            </HBox>

            <VBox fx:id="scoreBox"
                  spacing="10.0"
                  alignment="TOP_LEFT" />
        </VBox>
    </children>
</AnchorPane>