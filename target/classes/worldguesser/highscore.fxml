<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- VBOX AS THE ROOT CONTAINER FOR THE HIGHSCORE SCENE, WITH A CONTROLLER CLASS AND STYLING -->
<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="worldguesser.HighscoreController"
      spacing="25.0"
      prefWidth="500.0"
      prefHeight="750.0"
      style="-fx-background-color: #efcf93;
            -fx-padding: 20 22 20 22;"
      stylesheets="@style.css">

    <!-- HBOX CONTAINING THE TITLE AND THE HOME BUTTON -->
    <HBox alignment="CENTER_LEFT">

        <!-- LABEL DISPLAYING THE TITLE OF THE HIGHSCORE SCENE -->
        <Label text="Best times:"
               style="-fx-font-size: 24px; -fx-text-fill: black;" />

        <!-- REGION THAT PUSHES THE HOME BUTTON TO THE RIGHT SIDE -->
        <Region HBox.hgrow="ALWAYS" />

        <!-- HOME BUTTON WITH ACTION TO GO BACK TO THE MAIN MENU -->
        <Button fx:id="homeButton"
                styleClass="customButton"
                text="Home"
                mnemonicParsing="false"
                focusTraversable="false"
                prefWidth="85.0"
                prefHeight="38.0"
                onAction="#goBack" />
    </HBox>

    <!-- VBOX THAT WILL CONTAIN THE HIGHSCORE ENTRIES -->
    <VBox fx:id="scoreBox"
          spacing="10.0"
          alignment="TOP_LEFT" />

</VBox>