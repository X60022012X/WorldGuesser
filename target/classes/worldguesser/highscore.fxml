      alignment="CENTER"
      spacing="20"
      prefWidth="1000"
      prefHeight="800">

    <children>
        <TextArea fx:id="highscoreArea"
                  prefWidth="400"
                  prefHeight="600"
                  editable="false"/>
    </children>

</VBox>