<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="worldguesser.HighscoreController"
      alignment="CENTER"
      spacing="20"
      prefWidth="500"
      prefHeight="700">

    <Button fx:id="homeButton"
            styleClass="customButton"
            text="Home"
            mnemonicParsing="false"
            focusTraversable="false"
            prefWidth="85.0"
            prefHeight="38.0"
            onAction="#goBack" />

    <children>
        <TextArea fx:id="highscoreArea"
                  prefWidth="400"
                  prefHeight="600"
                  editable="false"/>
        
    </children>

</VBox>