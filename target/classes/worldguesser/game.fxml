<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- ANCHOR PANE AS THE ROOT CONTAINER FOR THE GAME SCENE, WITH A BACKGROUND COLOR AND A CONTROLLER CLASS -->
<AnchorPane xmlns:fx="http://javafx.com/fxml"
            stylesheets="@style.css"
            fx:controller="worldguesser.GameController"
            prefWidth="500.0"
            prefHeight="750.0"
            style="-fx-background-color: #efcf93;">

    <!-- THE MAIN CONTAINER FOR THE GAME SCENE -->
    <children>

        <!-- MAIN VBOX CONTAINING ALL ELEMENTS OF THE GAME SCENE -->
        <VBox prefWidth="500.0"
              prefHeight="750.0"
              AnchorPane.topAnchor="0.0"
              AnchorPane.bottomAnchor="0.0"
              AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0">

            <!-- TOP BAR WITH TARGET COUNTRY AND BUTTONS -->
            <HBox prefHeight="55.0"
                  alignment="CENTER_LEFT"
                  spacing="12.0"
                  style="-fx-background-color: #efcf93;">

                <!-- PADDING BETWEEN THE LEFT EDGE OF THE TOP BAR AND THE FIRST ELEMENT -->
                <padding>
                    <Insets top="10" right="12" bottom="10" left="18"/>
                </padding>

                <!-- LABEL DISPLAYING THE TARGET COUNTRY TO FIND -->
                <Label fx:id="targetCountryLabel"
                       text="Find: Norway"
                       style="-fx-font-size: 22px; -fx-text-fill: black;" />

                <!-- REGION TO PUSH THE BUTTONS TO THE RIGHT SIDE OF THE TOP BAR -->
                <Region HBox.hgrow="ALWAYS" />

                <!-- RESET BUTTON WITH ACTION TO RESET THE GAME -->
                <Button fx:id="resetButton"
                        styleClass="customButton"
                        text="Reset"
                        mnemonicParsing="false"
                        focusTraversable="false"
                        prefWidth="85.0"
                        prefHeight="38.0"
                        onAction="#resetGame" />

                <!-- HOME BUTTON WITH ACTION TO GO BACK TO THE MAIN MENU -->
                <Button fx:id="homeButton"
                        styleClass="customButton"
                        text="Home"
                        mnemonicParsing="false"
                        focusTraversable="false"
                        prefWidth="85.0"
                        prefHeight="38.0"
                        onAction="#goBack" />
            </HBox>

            <!-- MAP PANE WHERE THE MAP AND COUNTRIES WILL BE DISPLAYED, WITH A BACKGROUND COLOR -->
            <Pane fx:id="mapPane"
                  prefWidth="500.0"
                  prefHeight="380.0"
                  style="-fx-background-color: LIGHTSKYBLUE;" />

            <!-- BOTTOM VBOX CONTAINING GAME INFORMATION AND RESULT, WITH A BACKGROUND COLOR -->
            <VBox spacing="18.0"
                  prefWidth="500.0"
                  VBox.vgrow="ALWAYS"
                  style="-fx-background-color: #efcf93;">

                <!-- PADDING AROUND THE CONTENT OF THE BOTTOM VBOX -->
                <padding>
                    <Insets top="14" right="18" bottom="20" left="18"/>
                </padding>

                <!-- ATTEMPTS / COUNTRIES FOUND -->
                <HBox alignment="CENTER_LEFT">

                    <!-- LABEL DISPLAYING THE NUMBER OF ATTEMPTS LEFT -->
                    <Label fx:id="attemptsLabel"
                           text="Attempts: 3"
                           style="-fx-font-size: 22px;" />

                    <!-- REGION TO PUSH THE COUNTRIES LABEL TO THE RIGHT SIDE OF THE ROW -->
                    <Region HBox.hgrow="ALWAYS" />

                    <!-- LABEL DISPLAYING THE NUMBER OF COUNTRIES FOUND OUT OF THE TOTAL NUMBER OF COUNTRIES -->
                    <Label fx:id="countriesLabel"
                           text="Countries: 3/40"
                           style="-fx-font-size: 22px;" />
                </HBox>

                <!-- TIME / INCORRECTS ROW -->
                <HBox alignment="CENTER_LEFT">

                    <!-- LABEL DISPLAYING THE TIME ELAPSED SINCE THE START OF THE GAME -->
                    <Label fx:id="timeLabel"
                           text="Time: 23.5s"
                           style="-fx-font-size: 22px;" />

                    <!-- REGION TO PUSH THE INCORRECTS LABEL TO THE RIGHT SIDE OF THE ROW -->
                    <Region HBox.hgrow="ALWAYS" />

                    <!-- LABEL DISPLAYING THE NUMBER OF INCORRECT GUESSES MADE BY THE PLAYER -->
                    <Label fx:id="incorrectsLabel"
                           text="Incorrects: 9"
                           style="-fx-font-size: 22px;" />
                </HBox>

                <!-- RESULT BOX DISPLAYED WHEN THE GAME IS OVER -->
                <VBox fx:id="resultBox" spacing="6.0" visible="false" managed="false">

                    <!-- LABEL DISPLAYING THE RESULT OF THE GAME -->
                    <Label text="Result:"
                           style="-fx-font-size: 22px;" />

                    <!-- A BLACK LINE SEPARATING THE RESULT LABEL FROM THE TIME INFORMATION -->
                    <Pane prefHeight="2.0"
                          maxWidth="385.0"
                          style="-fx-background-color: black;" />

                    <!-- LABEL DISPLAYING THE TIME SPENT -->
                    <Label fx:id="timeSpentLabel"
                           text="Time spent: 40s"
                           style="-fx-font-size: 18px;" />

                    <!-- LABEL DISPLAYING THE TIME PENALTY FOR INCORRECT GUESSES -->
                    <Label fx:id="timePenaltyLabel"
                           text="Time penalty: 15s"
                           style="-fx-font-size: 18px;" />

                    <!-- LABEL DISPLAYING THE TOTAL TIME INCLUDING PENALTIES -->
                    <Label fx:id="totalTimeLabel"
                           text="Total time: 55s"
                           style="-fx-font-size: 18px; -fx-font-weight: bold;" />
                </VBox>

                <!-- REGION TO PUSH THE RESULT BOX TO THE TOP OF THE BOTTOM VBOX AND THE BUTTON TO THE BOTTOM -->
                <Region VBox.vgrow="ALWAYS" />

                <!-- HBOX CONTAINING THE TRY AGAIN BUTTON -->
                <HBox fx:id="bottomButtonBox" alignment="CENTER" visible="false" managed="false">
                    <Button fx:id="tryAgainButton"
                            styleClass="customButton"
                            text="Try Again"
                            mnemonicParsing="false"
                            focusTraversable="false"
                            prefWidth="170.0"
                            prefHeight="52.0"
                            onAction="#resetGame" />
                </HBox>
            </VBox>
        </VBox>
    </children>
</AnchorPane>